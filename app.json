{
  "expo": {
    "name": "ZonaBarber",
    "slug": "zonabarber",
    "scheme": "zonabarber",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#121014",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "ZonaBarber usa la foto que elijas para la imagen de un barbero.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zonabarber.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121014",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.zonabarber.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "static"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1259b3da-f855-489a-bb65-51c9842f1197"
      }
    },
    "owner": "mateotc0711"
  }
}
