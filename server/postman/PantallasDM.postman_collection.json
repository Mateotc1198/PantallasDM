    {
      "name": "Autenticación",
      "item": [
        {
          "name": "2. Login como admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Devuelve un JWT. El token se guarda solo en una variable de entorno; no hay que copiarlo a mano."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const cuerpo = pm.response.json();",
                  "",
                  "pm.test('devuelve token y usuario', () => {",
                  "    pm.expect(cuerpo.token).to.be.a('string').and.not.empty;",
                  "    pm.expect(cuerpo.user.role).to.be.oneOf(['admin', 'barbero']);",
                  "});",
                  "",
                  "pm.test('nunca viaja el hash de la contraseña', () => {",
                  "    pm.expect(JSON.stringify(cuerpo)).to.not.include('$2');",
                  "});",
                  "",
                  "// Encadena: las peticiones protegidas usan este token.",
                  "pm.environment.set('tokenAdmin', cuerpo.token);"
                ]
              }
            }
