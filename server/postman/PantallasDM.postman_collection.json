    {
      "name": "Citas",
      "item": [
        {
          "name": "14. Crear cita",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"barberId\": \"{{barberId}}\",\n  \"date\": \"{{fecha}}\",\n  \"time\": \"{{hora}}\",\n  \"customerName\": \"Mateo Torres\",\n  \"customerPhone\": \"3001112233\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings"
              ]
            },
            "description": "201 Created con cabecera Location apuntando al recurso nuevo."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Elige una franja valida al azar para que la coleccion se pueda",
                  "// repetir sin chocar siempre contra la misma hora.",
                  "const franjas = [];",
                  "for (let minutos = 9 * 60; minutos <= 19 * 60 + 30; minutos += 30) {",
                  "    const hh = String(Math.floor(minutos / 60)).padStart(2, '0');",
                  "    const mm = String(minutos % 60).padStart(2, '0');",
                  "    franjas.push(`${hh}:${mm}`);",
                  "}",
                  "pm.environment.set('hora', franjas[Math.floor(Math.random() * franjas.length)]);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "",
                  "const cita = pm.response.json();",
                  "",
                  "pm.test('la cabecera Location apunta al recurso creado', () => {",
                  "    pm.expect(pm.response.headers.get('Location')).to.eql(`/api/v1/bookings/${cita.id}`);",
                  "});",
                  "",
                  "pm.test('la cita nace activa', () => {",
                  "    pm.expect(cita.status).to.eql('activa');",
                  "});",
                  "",
                  "// Encadena: las peticiones siguientes usan este id sin copiarlo a mano.",
                  "pm.environment.set('bookingId', cita.id);"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "201 Created",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
