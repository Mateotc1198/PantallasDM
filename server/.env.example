# Copiar a .env y ajustar. NUNCA versionar el .env real.
NODE_ENV=development
PORT=3000

# Puerto en el que Docker publica PostgreSQL.
# Si lo cambias, cambia TAMBIEN el puerto dentro de DATABASE_URL.
DB_PORT=5434

# Debe coincidir con docker-compose.yml
DATABASE_URL=postgresql://pantallasdm:pantallasdm_dev@localhost:5434/pantallasdm
DATABASE_URL_TEST=postgresql://pantallasdm:pantallasdm_dev@localhost:5434/pantallasdm_test

# Secreto de firma de los JWT. Minimo 32 caracteres.
# CAMBIALO por una cadena larga y aleatoria antes de desplegar.
# Generar una: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria-de-al-menos-32-caracteres
JWT_EXPIRES_IN_SECONDS=28800

# Cuentas iniciales. Las crea "npm run users:seed" hasheando con bcrypt.
# En produccion van como variables secretas, nunca en el repositorio.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
BARBERO_USERNAME=luis
BARBERO_PASSWORD=
BARBERO_BARBER_ID=luis-gomez

# TLS hacia la base. true en Render/Neon, false en el Postgres local de Docker.
DATABASE_SSL=false

# Origenes permitidos por CORS, separados por coma. Vacio = ninguno.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
