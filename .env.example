# URL base de la API.
#
# Opcional: si no se define, la aplicación usa el despliegue de producción
# (https://pantallasdm-api.onrender.com), así que el proyecto funciona recién
# clonado sin configurar nada.
#
# Se sobrescribe para desarrollar contra un backend local. Ojo: desde un
# teléfono real "localhost" es el teléfono, no tu computador, así que hay que
# poner la IP de tu red local (la que imprime `npx expo start`).
#
#   EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
#
# El prefijo EXPO_PUBLIC_ significa que el valor se incrusta en el bundle y
# viaja dentro del APK: aquí nunca va un secreto.
EXPO_PUBLIC_API_URL=https://pantallasdm-api.onrender.com
